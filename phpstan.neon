includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    # Level 6: types, dead code, impossible conditions.
    level: 6
    paths:
        - papounan-site.php
        - includes/
        - modules/
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
    scanFiles:
        - vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php
    excludePaths:
        - vendor/
